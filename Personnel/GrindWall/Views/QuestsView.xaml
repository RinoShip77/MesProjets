<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GrindWall"
             x:Class="GrindWall.Views.QuestsView">
    <Grid>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
            <Label Text="{x:Static local:FontIcons.FlashFilled}" 
                   FontFamily="FluentFilled" 
                   FontSize="60" 
                   TextColor="#6366F1" 
                   HorizontalOptions="Center"/>
            <Label Text="Daily Quests" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#1E293B" 
                   HorizontalOptions="Center"/>
            <Label Text="Complete challenges to earn XP and rewards!" 
                   FontSize="16" 
                   TextColor="#64748B" 
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            
            <Border StrokeThickness="0" BackgroundColor="White" Padding="20" Margin="0,20,0,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Radius="10"/></Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Coming Soon: Quest System" HorizontalOptions="Center" TextColor="#94A3B8"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentView>
